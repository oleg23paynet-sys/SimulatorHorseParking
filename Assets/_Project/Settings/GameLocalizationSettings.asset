  - locale: ru
    key: interaction.construction.open
    text: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E"
  - locale: ru
    key: interaction.construction.opened
    text: "\u041E\u043A\u043D\u043E \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u043E"
  - locale: ru
    key: construction.parking_slot
    text: "\u041D\u043E\u0432\u043E\u0435 \u043F\u0430\u0440\u043A\u043E\u0432\u043E\u0447\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E"
  - locale: ru
    key: ui.construction.prompt
    text: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 E, \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E."
  - locale: ru
    key: ui.construction.title
    text: "\u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E"
  - locale: ru
    key: ui.construction.project
    text: "\u041E\u0431\u044A\u0435\u043A\u0442: {project}"
  - locale: ru
    key: ui.construction.requirements
    text: "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u043C"
  - locale: ru
    key: ui.construction.requirement
    text: "{resource}: \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435 {available}
      / \u043D\u0443\u0436\u043D\u043E {required}   \u2022   \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      {missing}"
  - locale: ru
    key: ui.construction.status.ready
    text: "\u0412\u0441\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B
      \u0435\u0441\u0442\u044C. \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C."
  - locale: ru
    key: ui.construction.status.missing
    text: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432 \u043D\u0430 \u0441\u043A\u043B\u0430\u0434\u0435."
  - locale: ru
    key: ui.construction.start
    text: "\u041D\u0430\u0447\u0430\u0442\u044C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E"
  - locale: ru
    key: ui.construction.stage35_only
    text: "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B.
      \u0420\u0430\u0441\u0445\u043E\u0434 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432
      \u0438 \u0441\u0442\u0440\u043E\u0439\u043A\u0430 \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F
      \u043D\u0430 \u044D\u0442\u0430\u043F\u0435 3.6."
  - locale: en
    key: interaction.construction.open
    text: Open construction
  - locale: en
    key: interaction.construction.opened
    text: Construction window opened
  - locale: en
    key: construction.parking_slot
    text: New parking space
  - locale: en
    key: ui.construction.prompt
    text: Press E to open construction.
  - locale: en
    key: ui.construction.title
    text: Construction
  - locale: en
    key: ui.construction.project
    text: 'Project: {project}'
  - locale: en
    key: ui.construction.requirements
    text: Material requirements
  - locale: en
    key: ui.construction.requirement
    text: "{resource}: warehouse {available} / required {required}   \u2022   missing
      {missing}"
  - locale: en
    key: ui.construction.status.ready
    text: All materials are available. Construction can begin.
  - locale: en
    key: ui.construction.status.missing
    text: Not enough materials in the warehouse.
  - locale: en
    key: ui.construction.start
    text: Start construction
  - locale: en
    key: ui.construction.stage35_only
    text: Requirements are met. Resource spending and construction arrive in Stage
      3.6.
  - locale: ru
    key: ui.construction.status.started
    text: "\u041C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0441\u043F\u0438\u0441\u0430\u043D\u044B.
      \u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C."
  - locale: ru
    key: ui.construction.status.in_progress
    text: "\u042D\u0442\u043E\u0442 \u043E\u0431\u044A\u0435\u043A\u0442 \u0443\u0436\u0435
      \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F."
  - locale: ru
    key: ui.construction.status.completed
    text: "\u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E."
  - locale: ru
    key: ui.construction.progress
    text: "\u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E:
      {progress}%"
  - locale: en
    key: ui.construction.status.started
    text: Materials consumed. Construction has started.
  - locale: en
    key: ui.construction.status.in_progress
    text: This project is already under construction.
  - locale: en
    key: ui.construction.status.completed
    text: Construction completed.
  - locale: en
    key: ui.construction.progress
    text: 'Construction: {progress}%'
  - locale: ru
    key: interaction.construction_worker.hit
    text: "\u0423\u0434\u0430\u0440\u0438\u0442\u044C \u0438 \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u044C"
  - locale: ru
    key: interaction.construction_worker.hit_done
    text: "\u0420\u0430\u0431\u043E\u0447\u0438\u0439 \u0441\u0442\u0430\u043B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
  - locale: ru
    key: construction.worker
    text: "\u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C"
  - locale: en
    key: interaction.construction_worker.hit
    text: Hit and hurry up
  - locale: en
    key: interaction.construction_worker.hit_done
    text: The worker is building faster
  - locale: en
    key: construction.worker
    text: construction worker
  - locale: ru
    key: ui.construction.choose_project
    text: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0437\u0434\u0430\u043D\u0438\u0435"
  - locale: ru
    key: ui.construction.option.available
    text: "{project} \u2014 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E"
  - locale: ru
    key: ui.construction.option.locked
    text: "{project} \u2014 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432"
  - locale: ru
    key: ui.construction.status.choose
    text: "\u041C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0441\u043E\u0431\u0440\u0430\u043D\u044B.
      \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0437\u0434\u0430\u043D\u0438\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0435\u0433\u043E
      \u043F\u0440\u0438\u0437\u0440\u0430\u043A."
  - locale: en
    key: ui.construction.choose_project
    text: Choose a building
  - locale: en
    key: ui.construction.option.available
    text: "{project} \u2014 available"
  - locale: en
    key: ui.construction.option.locked
    text: "{project} \u2014 missing materials"
  - locale: en
    key: ui.construction.status.choose
    text: Materials are ready. Select a building to preview it.
  - locale: ru
    key: ui.economy.summary
    text: "\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415 \u041F\u0410\u0420\u041A\u041E\u0412\u041A\u041E\u0419\n\u0417\u043E\u043B\u043E\u0442\u043E:
      {gold}   \u2022   \u0440\u0430\u0441\u0445\u043E\u0434\u044B \u0447\u0435\u0440\u0435\u0437
      {seconds} \u0441\n\u0417\u0430\u0440\u043F\u043B\u0430\u0442\u0430: {salary}  
      \u2022   \u0434\u0430\u043D\u044C \u043A\u043E\u0440\u043E\u043B\u044E: {tribute}"
  - locale: ru
    key: ui.economy.last_operation
    text: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u044F:
      {operation} {amount}"
  - locale: ru
    key: ui.economy.ready
    text: "\u0414\u043E\u0445\u043E\u0434\u044B \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u044B
      \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442 \u0447\u0435\u0440\u0435\u0437
      \u0435\u0434\u0438\u043D\u044B\u0439 \u043A\u043E\u0448\u0435\u043B\u0451\u043A."
  - locale: ru
    key: ui.economy.upgrade.buy
    text: "{upgrade} ({effect})\n\u0423\u0440\u043E\u0432\u0435\u043D\u044C {level}
      \u2192 {nextLevel}   \u2022   \u0426\u0435\u043D\u0430: {cost} \u0437\u043E\u043B\u043E\u0442\u0430"
  - locale: ru
    key: ui.economy.upgrade.maximum
    text: "{upgrade} ({effect})\n\u0423\u0440\u043E\u0432\u0435\u043D\u044C {level}
      \u2014 \u041C\u0410\u041A\u0421\u0418\u041C\u0423\u041C"
  - locale: ru
    key: economy.income.parking
    text: "\u0414\u043E\u0445\u043E\u0434 \u043E\u0442 \u043F\u0430\u0440\u043A\u043E\u0432\u043A\u0438"
  - locale: ru
    key: economy.expense.materials
    text: "\u041F\u043E\u043A\u0443\u043F\u043A\u0430 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432"
  - locale: ru
    key: economy.expense.driver_salary
    text: "\u0417\u0430\u0440\u043F\u043B\u0430\u0442\u0430 \u0432\u043E\u0437\u043D\u0438\u0446\u044B"
  - locale: ru
    key: economy.expense.royal_tribute
    text: "\u0414\u0430\u043D\u044C \u043A\u043E\u0440\u043E\u043B\u044E"
  - locale: ru
    key: economy.upgrade.cart_capacity
    text: "\u0412\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u044C \u0442\u0435\u043B\u0435\u0433\u0438"
  - locale: ru
    key: economy.upgrade.cart_speed
    text: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0442\u0435\u043B\u0435\u0433\u0438"
  - locale: ru
    key: economy.upgrade.construction_speed
    text: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430"
  - locale: ru
    key: economy.notice.expense_unpaid
    text: "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435: \u0437\u043E\u043B\u043E\u0442\u0430
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u043D\u0430 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0440\u0430\u0441\u0445\u043E\u0434. \u0411\u0430\u043B\u0430\u043D\u0441
      \u043D\u0435 \u0443\u0448\u0451\u043B \u0432 \u043C\u0438\u043D\u0443\u0441."
  - locale: ru
    key: economy.notice.upgrade_insufficient_gold
    text: "\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0437\u043E\u043B\u043E\u0442\u0430 \u0434\u043B\u044F \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F."
  - locale: ru
    key: economy.notice.maximum_level
    text: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u0443\u0436\u0435
      \u0434\u043E\u0441\u0442\u0438\u0433\u043B\u043E \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0443\u0440\u043E\u0432\u043D\u044F."
  - locale: en
    key: ui.economy.summary
    text: "PARKING MANAGEMENT\nGold: {gold}   \u2022   expenses in {seconds}s\nDriver
      salary: {salary}   \u2022   royal tribute: {tribute}"
